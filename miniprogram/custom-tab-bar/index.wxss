.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(23, 33, 43, 0.06);
  z-index: 999;
}
.tab-item {
  flex: 1;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.tab-hover {
  opacity: 0.7;
}
.tab-label {
  font-size: 24rpx;
  color: #62727d;
}
.tab-item.active .tab-label {
  color: #b42318;
  font-weight: 600;
}

/* ---------- 图标通用 ---------- */
.icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

/* ---------- 巡检任务：剪贴板 ---------- */
.icon-task {
  border: 4rpx solid #62727d;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}
.tab-item.active .icon-task {
  border-color: #b42318;
}
.icon-task-clip {
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 14rpx;
  border: 4rpx solid #62727d;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}
.tab-item.active .icon-task-clip {
  border-color: #b42318;
}
.icon-task-lines {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.icon-task-line {
  height: 4rpx;
  border-radius: 2rpx;
  background: #62727d;
}
.icon-task-line.short {
  width: 60%;
}
.tab-item.active .icon-task-line {
  background: #b42318;
}

/* ---------- 设施采集：加号 ---------- */
.icon-collect {
  border: 4rpx solid #62727d;
  border-radius: 10rpx;
  box-sizing: border-box;
}
.tab-item.active .icon-collect {
  border-color: #b42318;
}
.icon-collect-h,
.icon-collect-v {
  position: absolute;
  top: 50%;
  left: 50%;
  background: #62727d;
  border-radius: 3rpx;
}
.icon-collect-h {
  width: 22rpx;
  height: 5rpx;
  transform: translate(-50%, -50%);
}
.icon-collect-v {
  width: 5rpx;
  height: 22rpx;
  transform: translate(-50%, -50%);
}
.tab-item.active .icon-collect-h,
.tab-item.active .icon-collect-v {
  background: #b42318;
}

/* ---------- 数据看板：柱状图 ---------- */
.icon-chart {
  display: flex;
  align-items: flex-end;
  gap: 5rpx;
}
.icon-chart-bar {
  flex: 1;
  border-radius: 4rpx 4rpx 0 0;
  background: #62727d;
}
.icon-chart-bar.b1 { height: 18rpx; }
.icon-chart-bar.b2 { height: 30rpx; }
.icon-chart-bar.b3 { height: 24rpx; }
.tab-item.active .icon-chart-bar {
  background: #b42318;
}

/* ---------- 我的：人形 ---------- */
.icon-user-head {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #62727d;
}
.tab-item.active .icon-user-head {
  background: #b42318;
}
.icon-user-body {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 38rpx;
  height: 16rpx;
  border-radius: 10rpx 10rpx 6rpx 6rpx;
  background: #62727d;
}
.tab-item.active .icon-user-body {
  background: #b42318;
}

/* ---------- 中间扫码按钮 ---------- */
.tab-scan {
  flex: 1;
  position: relative;
  height: 110rpx;
}
.scan-btn {
  position: absolute;
  top: -46rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #b42318;
  border: 8rpx solid #ffffff;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(180, 35, 24, 0.35);
}
.scan-btn.busy {
  opacity: 0.75;
}
.scan-frame {
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid #ffffff;
  border-radius: 10rpx;
  position: relative;
  box-sizing: border-box;
}
.scan-frame::after {
  content: '';
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: 50%;
  height: 5rpx;
  margin-top: -3rpx;
  background: #ffffff;
  border-radius: 3rpx;
}
.scan-label {
  position: absolute;
  bottom: 10rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 24rpx;
  color: #b42318;
}
