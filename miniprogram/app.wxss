page {
  background: #f4f6f8;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  color: #17212b;
}
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}
.page-large {
  font-size: 36rpx;
}
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(23, 33, 43, 0.04);
}
.card-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.page-large .card-title { font-size: 40rpx; }
.muted {
  color: #7b8992;
  font-size: 26rpx;
}
.page-large .muted { font-size: 32rpx; }
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  background: #edf0f2;
  color: #45545e;
}
.badge.ok { background: #e3f3e9; color: #246b45; }
.badge.warn { background: #fff2d6; color: #815c00; }
.badge.info { background: #e3edf6; color: #2c5f88; }
.badge.danger { background: #fdece9; color: #b42318; }
.btn-primary {
  background: #b42318;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}
.page-large .btn-primary { font-size: 36rpx; }
.btn-primary[disabled] {
  background: #d8b3af;
  color: #ffffff;
}
.btn-ghost {
  background: #ffffff;
  color: #b42318;
  border: 2rpx solid #b42318;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
}
.btn-mini {
  display: inline-block;
  margin: 0;
  background: #b42318;
  color: #ffffff;
  border-radius: 10rpx;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border: none;
  line-height: 1.6;
}
.btn-mini.plain {
  background: #ffffff;
  color: #b42318;
  border: 2rpx solid #b42318;
}
.chips {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
  flex-wrap: wrap;
}
.chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #62727d;
  font-size: 27rpx;
}
.chip.active {
  background: #b42318;
  color: #ffffff;
}
.page-large .chip { font-size: 33rpx; }
.empty {
  text-align: center;
  color: #7c8a93;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 70rpx;
  margin-bottom: 16rpx;
}
.field {
  margin-bottom: 24rpx;
}
.field-label {
  font-size: 28rpx;
  color: #45545e;
  margin-bottom: 10rpx;
  display: block;
}
.page-large .field-label { font-size: 34rpx; }
.field-input {
  background: #f4f6f8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
}
.page-large .field-input { font-size: 36rpx; }
.field-textarea {
  background: #f4f6f8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}
