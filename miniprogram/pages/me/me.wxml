<view class="page {{largeText ? 'page-large' : ''}}">
  <view class="card user-card">
    <view class="avatar">{{visitor ? '客' : (user.displayName ? user.displayName[0] : '消')}}</view>
    <view class="user-info">
      <view class="card-title">{{visitor ? '访客' : (user.displayName || user.username)}}</view>
      <view class="muted">{{visitor ? '访客模式 · 只读浏览巡检状态和历史记录' : user.username + ' · ' + (user.roleCode === 'ADMIN' ? '系统管理员' : user.roleCode === 'GUARD' ? '保安' : '数据采集员')}}</view>
    </view>
  </view>

  <view class="card">
    <view class="setting-row">
      <view>
        <view class="setting-name">大字号模式</view>
        <view class="muted">放大页面文字，方便查看</view>
      </view>
      <switch checked="{{largeText}}" bindchange="toggleLargeText" color="#b42318" />
    </view>
  </view>

  <button class="btn-ghost logout-btn" bindtap="logout">{{visitor ? '退出访客 · 去登录' : '退出登录'}}</button>
</view>
