.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: #f4f6f8;
}

.page-large {
  font-size: 34rpx;
}

.page-head .hello {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.page-head .sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7b8c;
}

.head-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 28rpx 0 12rpx;
}

.scan-btn {
  padding: 18rpx 36rpx;
  border-radius: 40rpx;
  background: #b42318;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.back-link {
  font-size: 26rpx;
  color: #6b7b8c;
  text-decoration: underline;
}

.tip-banner {
  margin: 16rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #fff7e6;
  color: #ad6800;
  font-size: 26rpx;
}

.empty {
  margin-top: 160rpx;
  text-align: center;
  color: #8a97a5;
  font-size: 28rpx;
}

.component-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(31, 45, 61, 0.06);
}

.component-card.overdue {
  border-left: 8rpx solid #d4380d;
}

.component-card.due-soon {
  border-left: 8rpx solid #d46b08;
}

.component-main {
  flex: 1;
  min-width: 0;
}

.component-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.component-facility {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #43536a;
}

.component-location {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8a97a5;
}

.component-side {
  margin-left: 20rpx;
  text-align: right;
}

.due-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.due-badge.overdue {
  background: #fff1f0;
  color: #d4380d;
}

.due-badge.due-soon {
  background: #fff7e6;
  color: #d46b08;
}

.due-badge.normal {
  background: #f0f5ff;
  color: #1d39c4;
}

.due-badge.none {
  background: #f0f2f5;
  color: #8a97a5;
}

.due-date {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7b8c;
}

.form-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 32, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.form-sheet {
  width: 100%;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.form-target {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7b8c;
}

.type-switch {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 0;
}

.type-option {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  border-radius: 12rpx;
  background: #f0f2f5;
  color: #43536a;
  font-size: 28rpx;
}

.type-option.active {
  background: #b42318;
  color: #fff;
  font-weight: 600;
}

.field-label {
  margin: 24rpx 0 12rpx;
  font-size: 26rpx;
  color: #43536a;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f4f6f8;
  font-size: 28rpx;
  box-sizing: border-box;
}

.date-picker {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f4f6f8;
  font-size: 28rpx;
  color: #43536a;
}

.form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.form-btn {
  flex: 1;
  padding: 22rpx 0;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.form-btn.secondary {
  background: #f0f2f5;
  color: #43536a;
}

.form-btn.primary {
  background: #b42318;
  color: #fff;
  font-weight: 600;
}

.form-btn.disabled {
  opacity: 0.6;
}
