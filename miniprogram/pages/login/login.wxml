<view class="page {{largeText ? 'page-large' : ''}} login-page">
  <view class="login-hero">
    <view class="login-mark">消</view>
    <view class="login-title">消防设施巡检</view>
    <view class="login-sub">扫码巡检 · 定位校验 · 现场拍照留痕</view>
  </view>
  <view class="card login-card">
    <view class="card-title">账号登录</view>
    <view class="field">
      <text class="field-label">账号</text>
      <input class="field-input" value="{{username}}" bindinput="onUsername" placeholder="请输入巡检账号" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="field-input" password value="{{password}}" bindinput="onPassword" placeholder="请输入密码" placeholder-class="ph" />
    </view>
    <button class="btn-primary" loading="{{submitting}}" bindtap="login">登录</button>
    <button class="btn-ghost visitor-btn" bindtap="enterAsVisitor">访客浏览（免登录看巡检状态和记录）</button>
  </view>
</view>
