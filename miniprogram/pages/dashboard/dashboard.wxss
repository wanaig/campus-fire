.page {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}
.page-head {
  margin-bottom: 24rpx;
}
.hello {
  font-size: 42rpx;
  font-weight: 700;
}
.page-large .hello { font-size: 50rpx; }
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.stat-card {
  flex: 1;
  min-width: 40%;
  text-align: center;
  margin-bottom: 0;
}
.stat-value {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}
.page-large .stat-value { font-size: 62rpx; }
.stat-label {
  font-size: 26rpx;
  color: #7b8992;
  margin-top: 6rpx;
}
.stat-danger {
  background: #fdece9;
}
.stat-danger .stat-value {
  color: #b42318;
}
.stat-danger .stat-label {
  color: #b42318;
}
.trend-chart {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
  gap: 6rpx;
  margin-top: 12rpx;
}
.trend-col {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.trend-bar {
  width: 100%;
  max-width: 32rpx;
  background: #b42318;
  border-radius: 6rpx 6rpx 0 0;
  opacity: 0.8;
  min-height: 8rpx;
}
.trend-bar.empty {
  background: #e2e8ec;
  opacity: 1;
  border-radius: 0 0 3rpx 3rpx;
}
.dist-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  gap: 12rpx;
}
.dist-row + .dist-row {
  border-top: 2rpx solid #eef1f3;
}
.dist-count {
  font-size: 32rpx;
  font-weight: 600;
}
.type-name {
  font-size: 29rpx;
  font-weight: 500;
}
.maint-item {
  padding: 14rpx 0;
}
.maint-item + .maint-item {
  border-top: 2rpx solid #eef1f3;
}
.maint-name {
  font-size: 29rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}
.maint-date {
  margin-top: 8rpx;
}
.retry-btn {
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
}
.maint-hint {
  margin: -4rpx 0 8rpx;
}
.maint-tap {
  border-radius: 12rpx;
}
.maint-hover {
  background: #f4f6f8;
}
.page-large .maint-date {
  margin-top: 8rpx;
}
